# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# generated terrain/imagery tile pyramids — regenerated from source data via
# make_rarotonga_terrain_tiles.sh / retile_rarotonga_dtm_island_zooms.py, not
# hand-authored — too large for git (multi-GB, hundreds of thousands of files)
/public/terrain/
/public/imagery/

# browser network capture — can contain auth tokens/cookies, debug artifact only.
# Glob (not just the literal "localhost.har") since captures get renamed per
# session, e.g. CookIslandslocalhost.har, Niue.har.
*.har
